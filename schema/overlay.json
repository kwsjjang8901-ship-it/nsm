        "kind": {
          "desc": "summary(읽은 결과), invalid(형식이 틀려 뺀 정책), error(파일 읽기 오류)",
          "enum": [
            "summary",
            "invalid",
            "error"
          ]
        },
        "policy_id": {
          "desc": "정책 id(invalid 행)"
        },
        "msg": {
          "desc": "요약·이유"
        }
      }
    },
    "meta/meta_export_stats": {
