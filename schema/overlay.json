    "meta/http_ua_summary": {
      "title": "HTTP User-Agent 요약",
      "path": "/log/zeek/meta/http_ua_summary.log",
      "desc": "주기별 (출발, User-Agent) 요약(SRS_METADATA_EXPORT).",
