{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "선별 전송: http (meta/http)",
  "description": "Zeek 기본 로그의 선별본(필드는 meta_export_streams 의 fields). 필드 뜻은 Zeek 문서의 같은 로그를 따른다.",
  "x-path": "/log/zeek/meta/http.log",
  "type": "object",
  "properties": {
    "ts": {
      "type": "number",
      "x-zeek-type": "time"
    },
    "uid": {
      "type": "string",
      "x-zeek-type": "string"
    },
    "orig_h": {
      "type": "string",
      "anyOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ],
      "x-zeek-type": "addr"
    },
    "orig_p": {
      "type": "integer",
      "minimum": 0,
      "x-zeek-type": "port"
    },
    "resp_h": {
      "type": "string",
      "anyOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ],
      "x-zeek-type": "addr"
    },
    "resp_p": {
      "type": "integer",
      "minimum": 0,
      "x-zeek-type": "port"
    },
    "method": {
      "type": "string",
      "x-zeek-type": "string"
    },
    "host": {
      "type": "string",
      "x-zeek-type": "string"
    },
    "request_body_len": {
      "type": "integer",
      "minimum": 0,
      "x-zeek-type": "count"
    },
    "response_body_len": {
      "type": "integer",
      "minimum": 0,
      "x-zeek-type": "count"
    },
    "status_code": {
      "type": "integer",
      "minimum": 0,
      "x-zeek-type": "count"
    },
    "community_id": {
      "type": "string",
      "pattern": "^1:[A-Za-z0-9+/]{27}=$",
      "description": "연결의 Community ID v1(seed community_id_seed, 기본 0, base64). conn 5-tuple 로 계산하며 근거(evidence)의 community_id 와 같은 값이다. Manager 가 Suricata 경보 등 다른 제품의 이벤트와 연결 단위로 잇는 키(SURICATA_INTEGRATION_DESIGN 3.3)",
      "x-zeek-type": "string"
    },
    "uri_path": {
      "type": "string",
      "x-zeek-type": "string"
    }
  },
  "required": [
    "ts",
    "uid",
    "orig_h",
    "orig_p",
    "resp_h",
    "resp_p",
    "request_body_len",
    "response_body_len"
  ],
  "additionalProperties": false
}
