{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "선별 전송: smb_files (meta/smb_files)",
  "description": "Zeek 기본 로그의 선별본(필드는 meta_export_streams 의 fields). 필드 뜻은 Zeek 문서의 같은 로그를 따른다.",
  "x-path": "/log/zeek/meta/smb_files.log",
  "type": "object",
  "properties": {
    "ts": {
      "type": "number",
      "x-zeek-type": "time"
    },
    "uid": {
      "type": "string",
      "x-zeek-type": "string"
    },
    "orig_h": {
      "type": "string",
      "anyOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ],
      "x-zeek-type": "addr"
    },
    "orig_p": {
      "type": "integer",
      "minimum": 0,
      "x-zeek-type": "port"
    },
    "resp_h": {
      "type": "string",
      "anyOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ],
      "x-zeek-type": "addr"
    },
    "resp_p": {
      "type": "integer",
      "minimum": 0,
      "x-zeek-type": "port"
    },
    "action": {
      "type": "string",
      "x-zeek-type": "enum SMB::Action"
    },
    "path": {
      "type": "string",
      "x-zeek-type": "string"
    },
    "name": {
      "type": "string",
      "x-zeek-type": "string"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "x-zeek-type": "count"
    },
    "prev_name": {
      "type": "string",
      "x-zeek-type": "string"
    }
  },
  "required": [
    "ts",
    "uid",
    "orig_h",
    "orig_p",
    "resp_h",
    "resp_p",
    "size"
  ],
  "additionalProperties": false
}
