{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOC 파일 적재 (nsm_ioc)",
  "description": "IOC 파일을 읽은 결과.",
  "x-path": "/log/zeek/nsm_ioc.log",
  "type": "object",
  "properties": {
    "ts": {
      "type": "number",
      "description": "기록 시각(실제 시각, 벽시계)",
      "x-zeek-type": "time"
    },
    "kind": {
      "type": "string",
      "enum": [
        "summary",
        "invalid",
        "error",
        "file"
      ],
      "description": "summary(읽은 결과), invalid(형식이 틀려 뺀 항목), error(파일 읽기 오류), file(읽은 IOC 파일의 지문)",
      "x-zeek-type": "string"
    },
    "indicator": {
      "type": "string",
      "description": "IOC 값(invalid 행)",
      "x-zeek-type": "string"
    },
    "ioc_type": {
      "type": "string",
      "description": "IOC 종류(ip, domain, url 등. 모르면 -)",
      "x-zeek-type": "string"
    },
    "msg": {
      "type": "string",
      "description": "요약·이유. kind=file 은 IOC 파일 경로",
      "x-zeek-type": "string"
    },
    "file_sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "kind=file: 읽은 IOC 파일의 SHA1. 파일을 다시 읽을 때마다 한 행",
      "x-zeek-type": "string"
    }
  },
  "required": [
    "ts",
    "kind"
  ],
  "additionalProperties": false
}
