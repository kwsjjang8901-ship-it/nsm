{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "에이전트 정책 적재 (asset_agent_policy)",
  "description": "고객 정의 에이전트 정책 파일을 읽은 결과(SPEC 3.17).",
  "x-path": "/log/zeek/asset_agent_policy.log",
  "type": "object",
  "properties": {
    "ts": {
      "type": "number",
      "description": "기록 시각(실제 시각, 벽시계)",
      "x-zeek-type": "time"
    },
    "kind": {
      "type": "string",
      "enum": [
        "summary",
        "invalid",
        "error",
        "file"
      ],
      "description": "summary(읽은 결과), invalid(형식이 틀려 뺀 정책), error(파일 읽기 오류), file(읽은 정책 파일의 지문)",
      "x-zeek-type": "string"
    },
    "policy_id": {
      "type": "string",
      "description": "정책 id(invalid 행)",
      "x-zeek-type": "string"
    },
    "msg": {
      "type": "string",
      "description": "요약·이유. kind=file 은 정책 파일 경로",
      "x-zeek-type": "string"
    },
    "file_sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "kind=file: 읽은 정책 파일의 SHA1. 파일을 다시 읽을 때마다 한 행",
      "x-zeek-type": "string"
    }
  },
  "required": [
    "ts",
    "kind",
    "msg"
  ],
  "additionalProperties": false
}
