{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "근거 (evidence)",
  "description": "탐지 1건에 근거 여러 행. evidence_id 로 nsm_detection.evidence_ids 와 조인하고, uid·fuid 로 conn.log·files.log·선별 전송 로그와 조인한다.",
  "x-path": "/log/zeek/evidence.log",
  "type": "object",
  "properties": {
    "ts": {
      "type": "number",
      "description": "근거 시각",
      "x-zeek-type": "time"
    },
    "evidence_id": {
      "type": "string",
      "description": "어느 탐지의 근거인지(notice·nsm_detection 과 공유하는 키)",
      "x-zeek-type": "string"
    },
    "note": {
      "type": "string",
      "pattern": "^NSM::[A-Za-z0-9_]+$",
      "description": "탐지 종류(Zeek notice 이름, NSM::<룰>)",
      "x-zeek-type": "enum Notice::Type"
    },
    "rule": {
      "type": "string",
      "enum": [
        "AD_Enumeration",
        "AI_API_From_Server",
        "AI_Service_Exploit",
        "AI_Service_Upload",
        "ASREP_Roasting",
        "Coerced_Authentication",
        "Correlated_KillChain",
        "Cross_Site_Scripting",
        "DCOM_Lateral",
        "DCSync",
        "DGA_Domain",
        "DNS_Tunneling",
        "Encrypted_C2",
        "Exfil_DNS",
        "Exfil_Large_Transfer",
        "Exfil_Volume_Aggregate",
        "Exfil_Web_Upload",
        "FTP_Bruteforce",
        "HTTP_Beaconing",
        "HTTP_Bruteforce",
        "Host_Scan",
        "IOC_Match",
        "Kerberoasting",
        "Kerberos_Bruteforce",
        "Kerberos_Spray",
        "Long_Connection",
        "Machine_Account_Misuse",
        "NTLM_Credential_Leak",
        "NTLM_Spray",
        "Name_Poisoning",
        "Nonstandard_Port",
        "Outbound_SMB",
        "Port_Scan",
        "RDP_Lateral",
        "Remote_Registry_Dump",
        "Remote_Service_Creation",
        "Remote_Task_Creation",
        "Remote_WMI_Execution",
        "SMB_Admin_Share",
        "SMB_Ransomware",
        "SQL_Injection",
        "SSH_Bruteforce",
        "SSH_Lateral",
        "TLS_Beaconing",
        "TLS_Heartbleed",
        "Unknown_Protocol",
        "Webshell_Access",
        "WinRM_Lateral",
        "Zerologon_Attempt"
      ],
      "description": "note 에서 NSM:: 를 뺀 값(nsm_detection.rule 과 같음)",
      "x-zeek-type": "string"
    },
    "killchain_stage": {
      "type": "string",
      "enum": [
        "Command and Control",
        "Credential Access",
        "Exfiltration",
        "Impact",
        "Initial Access",
        "Lateral Movement",
        "Recon"
      ],
      "description": "킬체인 단계명",
      "x-zeek-type": "string"
    },
    "technique": {
      "type": "string",
      "pattern": "^T[0-9]{4}(\\.[0-9]{3})?((, ?|->)T[0-9]{4}(\\.[0-9]{3})?)*$",
      "description": "ATT&CK 기법 id. 여러 개면 쉼표, 상관 근거는 단계 순서를 -> 로 이음",
      "x-zeek-type": "string"
    },
    "account": {
      "type": "string",
      "description": "관련 계정 원문(알 때만). 여러 개면 쉼표. 확산 근거는 인증 맥락에서 찾은 값",
      "x-zeek-type": "string"
    },
    "user_name": {
      "type": "string",
      "description": "account(첫 계정)의 사용자 부분, 소문자",
      "x-zeek-type": "string"
    },
    "user_domain": {
      "type": "string",
      "description": "account(첫 계정)의 도메인 부분. domain\\user 의 domain, user@realm 의 realm",
      "x-zeek-type": "string"
    },
    "user_domain_type": {
      "type": "string",
      "enum": [
        "dns",
        "netbios"
      ],
      "description": "user_domain 에 점이 있으면 dns, 없으면 netbios",
      "x-zeek-type": "string"
    },
    "src": {
      "type": "string",
      "anyOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ],
      "description": "출발 host",
      "x-zeek-type": "addr"
    },
    "dst": {
      "type": "string",
      "anyOf": [
        {
          "format": "ipv4"
        },
        {
          "format": "ipv6"
        }
      ],
      "description": "대상 host",
      "x-zeek-type": "addr"
    },
    "operation": {
      "type": "string",
      "description": "행위(예: kerberos_as_failure, smb_tree_connect, killchain)",
      "x-zeek-type": "string"
    },
    "uid": {
      "type": "string",
      "pattern": "^C[0-9A-Za-z]+$",
      "description": "근거 연결의 Zeek uid(conn.log 등과 조인). 집계형은 표본 대상마다 대표 연결 하나",
      "x-zeek-type": "string"
    },
    "src_port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "근거 연결의 src 쪽 포트(근거 src·dst 방향에 맞춤)",
      "x-zeek-type": "count"
    },
    "dst_port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "근거 연결의 dst 쪽 포트(프록시 경유면 프록시 포트)",
      "x-zeek-type": "count"
    },
    "proto": {
      "type": "string",
      "enum": [
        "tcp",
        "udp",
        "icmp"
      ],
      "description": "근거 연결의 전송 프로토콜",
      "x-zeek-type": "string"
    },
    "community_id": {
      "type": "string",
      "pattern": "^1:[A-Za-z0-9+/]{27}=$",
      "description": "근거 연결의 Community ID v1(seed community_id_seed, 기본 0)",
      "x-zeek-type": "string"
    },
    "dst_name": {
      "type": "string",
      "description": "목적지 이름(sni > host > name > DNS 상위 도메인 > 질의). 소문자, IP 제외",
      "x-zeek-type": "string"
    },
    "proxy": {
      "type": "string",
      "pattern": "^\\S+:[0-9]+$",
      "description": "거쳐 간 명시적 프록시 주소:포트",
      "x-zeek-type": "string"
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "description": "출발지가 보낸 바이트",
      "x-zeek-type": "count"
    },
    "window_s": {
      "type": "number",
      "minimum": 0,
      "description": "집계형 근거의 집계 창(초)",
      "x-zeek-type": "double"
    },
    "fuid": {
      "type": "string",
      "description": "근거 파일의 Zeek fuid(files.log 조인)",
      "x-zeek-type": "string"
    },
    "parent_id": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "상관 근거가 묶는 하위 evidence_id",
      "x-zeek-type": "vector of string"
    },
    "detail": {
      "type": "string",
      "description": "사람이 읽는 부가 정보(key=value). 형식은 룰마다 다르며 파싱하지 않는다",
      "x-zeek-type": "string"
    }
  },
  "required": [
    "ts",
    "evidence_id"
  ],
  "additionalProperties": false
}
